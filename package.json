{
  "name": "rosetta-core-foundation",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "check": "node scripts/check.mjs",
    "check:contracts": "python -B scripts/check-contracts.py",
    "test:contract-validator": "python -B scripts/check-contracts.py --self-test",
    "test": "node --test \"tests/*.test.mjs\"",
    "healthcheck": "node scripts/check-health.mjs",
    "example:foundation": "node --env-file-if-exists=.env examples/foundation-http.mjs",
    "test:integration": "node --env-file=.env --test integration/core.mjs",
    "test:recovery": "node --env-file=.env --test integration/recovery.mjs",
    "test:applications": "node --env-file=.env --test integration/applications.mjs",
    "test:capabilities": "node --env-file=.env --test integration/capabilities.mjs",
    "test:audit": "node --env-file=.env --test integration/audit.mjs",
    "test:flowable-worker": "node --test integration/flowable-worker.mjs",
    "test:console-container": "node scripts/check-console-container.mjs",
    "console": "npm --prefix console run dev",
    "console:build": "npm --prefix console run build",
    "console:test": "npm --prefix console test",
    "console:check:endpoints": "npm --prefix console run check:endpoints"
  }
}
