# Junctura DX-OS — repository hygiene
# Keep source, AGENTS.md, documentation, LICENSE, lockfiles,
# migration scripts, tests and reproducible deployment examples tracked.

# OS / editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
*.tmp
*.bak
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Secrets and local-only configuration
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
.openbao/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.tfstate
*.tfstate.*
!*.tfstate.example
*.tfvars
!*.tfvars.example
.terraform/
.terraform.tfstate.lock.info
# Never store real credentials in tracked example files.

