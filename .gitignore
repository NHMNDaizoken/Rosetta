*.test
coverage.out

# Generated outputs (all languages)
**/dist/
console/public/THIRD-PARTY-NOTICES.txt
**/build/
**/out/
**/tmp/
**/temp/
**/.cache/

# Logs, runtime state and local databases
# Local backups contain private data and identities (npm run backup).
backups/
# Local provider CA and keys (npm run provider:pki).
.junctura/
*.log
logs/
*.pid
*.pid.lock
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.rdb
*.aof
runtime-data/
local-data/
uploads/

# Infrastructure local state
*.retry
.helmignore.local
.kube/config
minikube/
kind-data/

# Generated SDKs (ignore only if reproducible and not distributed in repo)
# packages/sdk-*/generated/

# Do NOT ignore: README.md, LICENSE, CHANGELOG.md, REUSE.toml,
# docs/, tests/, Dockerfiles, compose*.yaml, OpenAPI specs,
# package-lock.json, pnpm-lock.yaml, yarn.lock, uv.lock,
# poetry.lock, requirements*.txt, go.sum, gradle wrapper,
# or source/configuration templates needed for build-from-source.
# AI-agent instruction files stay local via the patterns above.
