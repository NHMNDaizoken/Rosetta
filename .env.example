# LOCAL DEVELOPMENT ONLY. Run npm run setup; never commit generated secrets.
# Foundation / loopback Gateway
# Native server binding. Compose overrides HOST inside the container.
HOST=127.0.0.1
# Native listening port and Compose's host port (1-65535).
PORT=8080
PUBLIC_URL=http://127.0.0.1:8080
# Console (npm run local:up enables it)
CONSOLE_PORT=3000
# Capability Registry / Trust use Foundation identity and private data authority.
# Enrollment and independent approval are operator tasks, never bootstrapped here.
# Deprecated v1 data/objects: explicit trusted backend clients only. Empty disables.
# Compose defaults to the three local service fixtures when unset; native defaults empty.
LEGACY_RESOURCE_CLIENTS=tenant-a,tenant-b,reader
# C4A guarded single-capability execution is opt-in. Exact approved HTTPS origins
# as a JSON array; no test-network exceptions are accepted by the production server.
C4A_ENABLED=false
C4A_PROVIDER_ORIGINS=[]
# C4B bounded composition remains disabled by default. Isolated tests opt in privately.
C4B_ENABLED=false
C4B_PROVIDER_ORIGINS=[]
# Internal providers (Layer 2 services running next to the platform): exact
# https://<name>.provider.internal:<port> origins on private addresses, trusted only
# through the local provider CA. Create it with npm run provider:pki and start the
# stack with compose.providers.yaml (see docs/CAPABILITY_EXECUTION.md).
C4A_INTERNAL_PROVIDER_ORIGINS=[]
C4B_INTERNAL_PROVIDER_ORIGINS=[]
# Do not copy working credentials into this template. npm run setup generates .env.
# Databases: separate administrative, Identity, Data and Workflow accounts
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
DATA_DB_PASSWORD=
WORKFLOW_DB_PASSWORD=
# Identity: operator administration and Core introspection
KEYCLOAK_ADMIN_PASSWORD=
CORE_CLIENT_SECRET=
# Optional synthetic local Identity fixtures (not enrolled applications)
TENANT_A_SECRET=
TENANT_B_SECRET=
READER_SECRET=
SSO_USER_PASSWORD=
# Structured data: private short-lived assertion signing
DATA_JWT_SECRET=
# Workflow: private engine administration
WORKFLOW_ADMIN_PASSWORD=
# Storage: private SeaweedFS network; no application storage credential.
# Malware scanning: ClamAV on the internal scanner network (Compose sets host/port).
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000
# Secrets: OpenBao on the internal secrets network. Compose mounts the Core token
# from the openbao-init volume (SECRETS_TOKEN_FILE). Do not commit operator keys.
# SECRETS_URL=
# SECRETS_TOKEN_FILE=
# SECRETS_MOUNT=secret
